# Cup night emails: settings for the send-emails and unsubscribe Supabase Edge Functions.
# The website itself needs no env vars (its Supabase URL and publishable key are public, in src/lib/supabaseClient.js).
#
# Copy to .env (gitignored), fill in, then:
#   npx supabase secrets set --env-file .env --project-ref ikbcapdpatjwozjdgcqk
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are given to Edge Functions automatically; don't set them here.

# "log" (the default) only writes emails to the function logs. "send" really sends, and needs RESEND_API_KEY.
EMAIL_MODE=log

# Resend API key (resend.com › API Keys). Resend only sends to other people from a domain you've verified.
RESEND_API_KEY=

# Who emails come from. Must be an address on your verified domain.
EMAIL_FROM="Night Kart League <cup-nights@example.com>"

# Where the links in emails point (the event page and the unsubscribe page).
SITE_URL=https://megmax.github.io/kart-league/

# Long random string. pg_cron sends it to send-emails; it must match the Vault secret "email_worker_secret".
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Optional: the league name shown in emails.
LEAGUE_NAME=Night Kart League

# Gemini API key for `npm run backlog` (reads a folder of results photos on your machine). Not used by the
# website or the Edge Functions. Get one at https://aistudio.google.com/apikey. GEMINI_MODEL overrides the model.
GEMINI_API_KEY=
