rules_version = '2';

// Kart Night League access rules.
// Roles: the owner (uid in config/owner, claimed once), admins (users/{uid}.role == "admin"), members (everyone signed in).
// Everyone, signed in or not, can read the league, players, cups and cup photos.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownerExists() { return exists(/databases/$(database)/documents/config/owner); }
    function ownerUid() { return get(/databases/$(database)/documents/config/owner).data.uid; }
    function isOwnerUid(uid) { return ownerExists() && ownerUid() == uid; }
    function isOwner() { return signedIn() && isOwnerUid(request.auth.uid); }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() {
      return signedIn() && (isOwner()
        || (hasProfile() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function shortString(v, max) { return v is string && v.size() <= max; }

    // League ownership: claimable exactly once, never changed from the app.
    match /config/owner {
      allow read: if true;
      allow create: if signedIn() && !ownerExists()
        && request.resource.data.keys().hasOnly(['uid', 'claimedAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Public league data: only admins change it.
    match /league/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /players/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /cups/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /photos/{id}    { allow read: if true; allow write: if isAdmin(); }

    // Account profiles: you read and edit your own; admins read all and set roles.
    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'email', 'role', 'color', 'favoriteCharacter', 'favoriteVehicle', 'createdAt', 'updatedAt'])
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 40
        && shortString(d.color, 9)
        && shortString(d.favoriteCharacter, 40)
        && shortString(d.favoriteVehicle, 40);
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.get('email', '')
        && validProfile(request.resource.data);
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && changedOnly(['displayName', 'color', 'favoriteCharacter', 'favoriteVehicle', 'updatedAt'])
          && validProfile(request.resource.data))
        || (isAdmin() && !isOwnerUid(uid)
          && changedOnly(['role', 'updatedAt'])
          && request.resource.data.role in ['member', 'admin'])
      );
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Cup submissions from members: they wait for an admin to approve or reject them.
    match /submissions/{id} {
      allow read: if signedIn() && (resource.data.submittedBy == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['cup', 'date', 'max', 'rows', 'notes', 'hasPhoto', 'status', 'submittedBy', 'submitterName', 'submittedAt'])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rows is list && request.resource.data.rows.size() <= 24
        && shortString(request.resource.data.notes, 500)
        && shortString(request.resource.data.cup, 40);
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.submittedBy == request.auth.uid && resource.data.status == 'pending');
    }
    match /submissionPhotos/{id} {
      allow read: if signedIn() && (resource.data.submittedBy == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['data', 'submittedBy'])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if isAdmin() || (signedIn() && resource.data.submittedBy == request.auth.uid);
    }
  }
}
